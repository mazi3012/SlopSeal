{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "slopseal": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/mazi3012/SlopSeal.git", "slopseal-mcp"],
      "env": {
        "SLOPSEAL_OFFLINE_SNAPSHOT": "1",
        "SLOPSEAL_SNAPSHOT_DIR": "src/slopseal/fixtures",
        "SLOPSEAL_STATE_DIR": ".slopseal",
        "SLOPSEAL_POLICY_PATH": ".kiro/steering/dependency-trust.md"
      }
    }
  }
}
