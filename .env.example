# Copy to .env for local use. .env is git-ignored. Never commit real values.

# Unset or 1: checks use the checksummed offline snapshot, with the clock pinned to its as_of.
# 0: live mode queries PyPI, npm, and OSV. Every failed answer blocks. The registries do not
# publish maintainer account age, so live mode blocks every package today (THREAT_MODEL T5).
SLOPSEAL_OFFLINE_SNAPSHOT=1

# Snapshot directory used when SLOPSEAL_OFFLINE_SNAPSHOT=1.
SLOPSEAL_SNAPSHOT_DIR=src/slopseal/fixtures

# Directory for the audit log, quarantine state, pending approvals, and the seal key.
SLOPSEAL_STATE_DIR=.slopseal

# Path to the trust policy. Default shown.
SLOPSEAL_POLICY_PATH=.kiro/steering/dependency-trust.md

# Log level: DEBUG, INFO, WARNING, ERROR
SLOPSEAL_LOG_LEVEL=INFO

# The seal key is generated on first use at $SLOPSEAL_STATE_DIR/secret.key (mode 0600).
# It is never read from an environment variable and never committed (Open Decision 6, resolved).
