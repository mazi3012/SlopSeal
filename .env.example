# Copy to .env for local use. .env is git-ignored. Never commit real values.

# 1 = run every check against the signed snapshot, no network.
SLOPSEAL_OFFLINE_SNAPSHOT=0

# Directory for the audit log, quarantine state, and pending approvals.
SLOPSEAL_STATE_DIR=.slopseal

# Path to the trust policy. Default shown.
SLOPSEAL_POLICY_PATH=.kiro/steering/dependency-trust.md

# Path to the HMAC-SHA256 key for seals (v1 scheme, ADR 0002). Key storage is
# Open Decision 6. Leave empty until it is set. Never commit a key file.
SLOPSEAL_SIGNING_KEY_PATH=

# Log level: DEBUG, INFO, WARNING, ERROR
SLOPSEAL_LOG_LEVEL=INFO

# Set by the PATH shim itself to stop recursion. Do not set by hand.
# SLOPSEAL_ACTIVE=1
